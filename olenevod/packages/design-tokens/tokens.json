{
  "$schema": "./tokens.schema.json",
  "name": "@olenevod/design-tokens",
  "version": "1.0.0",
  "description": "Дизайн-токены Olenevod: цвета, шрифты, размеры, брейкпоинты, z-индексы, токены движения",
  "color": {
    "ink-950": "#0E0B09",
    "ink-900": "#14100D",
    "ink-850": "#1A1511",
    "ink-800": "#211B16",
    "ink-700": "#2D251E",
    "line": "#3A3027",
    "paper-100": "#F2EADB",
    "paper-300": "#CFC4B0",
    "paper-500": "#9A8F7C",
    "ember-300": "#EE7D5A",
    "ember-400": "#E8603B",
    "ember-500": "#D4492A",
    "ember-600": "#B33A20",
    "ember-700": "#8E2D18",
    "flame-500": "#F26B1D",
    "brass-400": "#C8A468",
    "brass-600": "#8F7340",
    "tundra-700": "#1F3A3D",
    "tundra-400": "#6FA3B8",
    "meat-600": "#6E1F25",
    "success": "#5E9E6E",
    "warning": "#D9A441",
    "danger": "#E0524A",
    "paper-bg": "#E9E0CE",
    "paper-ink": "#15110E"
  },
  "typography": {
    "fontFamily": {
      "display": ["Oswald", "system-ui", "Segoe UI", "Roboto", "Arial", "sans-serif"],
      "text": ["Golos Text", "system-ui", "Segoe UI", "Roboto", "Arial", "sans-serif"],
      "mono": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    },
    "fontSize": {
      "display-xxl": "clamp(72px, 15vw, 256px)",
      "display-xl": "clamp(56px, 10vw, 160px)",
      "display-lg": "clamp(40px, 6vw, 96px)",
      "display-md": "clamp(28px, 3.4vw, 48px)",
      "h3": "24px",
      "body-lg": "18px",
      "body": "16px",
      "small": "14px",
      "mono-s": "12px"
    },
    "lineHeight": {
      "display-xxl": "0.82",
      "display-xl": "0.86",
      "display-lg": "0.9",
      "display-md": "0.95",
      "h3": "1.2",
      "body-lg": "1.55",
      "body": "1.6",
      "small": "1.5",
      "mono-s": "1.4"
    },
    "letterSpacing": {
      "display-xxl": "-0.01em",
      "display-xl": "-0.005em",
      "display-lg": "0",
      "display-md": "0.005em",
      "mono-s": "0.06em",
      "mono-caps": "0.08em"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semiBold": 600,
      "bold": 700
    },
    "fontStyle": {
      "normal": "normal",
      "uppercase": "uppercase"
    }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192],
  "breakpoints": {
    "xs": 360,
    "sm": 480,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "header": 20,
    "drawer": 30,
    "modal": 40,
    "toast": 50
  },
  "borderRadius": {
    "none": 0,
    "sm": 2,
    "pill": 9999
  },
  "borderWidth": {
    "hairline": 1,
    "accent": 2
  },
  "motion": {
    "durInstant": "100ms",
    "durFast": "160ms",
    "durBase": "240ms",
    "durSlow": "420ms",
    "durHero": "900ms",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)",
    "easeLinear": "linear",
    "springCart": { "stiffness": 380, "damping": 28, "mass": 1 },
    "springDrawer": { "stiffness": 300, "damping": 34 },
    "motionScale": 1
  }
}
