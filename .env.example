# Olenevod — переменные окружения (пример).
# Скопируйте в .env и задайте реальные значения перед запуском.
# Реальные реквизиты владельца не публиковать — помечены TODO_OWNER (см. DECISIONS.md §1.a).

# Режим работы: demo | production
APP_MODE=demo

# --- База данных (PostgreSQL 16) ---
POSTGRES_DB=olenevod
POSTGRES_USER=olenevod
POSTGRES_PASSWORD=olenevod_dev
DATABASE_URL=postgresql+psycopg://olenevod:olenevod_dev@localhost:5432/olenevod

# --- Кэш и очередь (Redis 7) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- Секрет приложения (токены сессий, подпись, шифрование полей) ---
SECRET_KEY=dev-secret-change-me-in-production

# --- Боты (реальные токены предоставляет владелец; в демо VERIFIED_SIMULATED) ---
BOT_TOKEN_TELEGRAM=TODO_OWNER
BOT_TOKEN_VK=TODO_OWNER
BOT_TOKEN_MAX=TODO_OWNER

# --- SMTP (уведомления) ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=TODO_OWNER
SMTP_PASSWORD=TODO_OWNER
SMTP_FROM=noreply@olenevod.local

# --- Платёжный провайдер (ЮКassa в тестовом режиме; боевые ключи — владелец) ---
PAYMENT_PROVIDER=yukassa
PAYMENT_PROVIDER_SECRET_KEY=TODO_OWNER
PAYMENT_PROVIDER_SHOP_ID=TODO_OWNER

# --- Яндекс Метрика (вкл. после согласия пользователя) ---
YANDEX_METRIKA_ID=TODO_OWNER

# --- Порты сервисов ---
API_PORT=8000
WEB_PORT=3000
ADMIN_PORT=5173
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
